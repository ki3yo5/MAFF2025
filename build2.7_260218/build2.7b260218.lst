Model definition and solve


 597      Model crop_constraint   /
 598                                link,landbal,areamax_o,areamax_l
 599                                labdemand_c,labdemand_l,labbal
 602                              /;
 603      Model area_max          /
 604                                areamax_y,areamax_u,areamax_p
 605                                areamax_wheat,areamax_barley,areamax_sweetp,areamax_potato,areamax_soy
 606                              /;
 607      Model animal_constraint /
 608                                tdndemand,tdnsupply,tdnbal
 609                                dmsupply,distbal
 610                                bredbal
 613                              /;
 614      Model balance           /
 615                                nutpet_c, nutpet_f, nutpet_l,
 616                                caloriebal,caloriebal_r
 617                                dietpet_c,dietpet_f,dietpet_l
 618                                dietbal,dietbal_r,
 619                                adietbal,adietbal_r
 620                              /;
 621   
 622  * Standard solution
 623      Model sol_dif           / crop_constraint + area_max + animal_constraint + balance + dif /;
 624      Model sol_rat           / crop_constraint + area_max + animal_constraint + balance + rat /;
 625   
 626  * Solution without expansion upper bound
 627      Model sol_dif_unlimited / sol_dif - area_max /;
 628      Model sol_rat_unlimited / sol_rat - area_max /;
 629   
 630  * First-year scenario
 631      Model sol_dif_jan       / sol_dif+jan /;
