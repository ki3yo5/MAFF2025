--- LOAD  edemand = 8:edemand
--- LOAD  esupply = 9:esupply
--- LOAD  fertcoef = 10:fertcoef
--- LOAD  ldemand_c = 11:ldemand_c
--- LOAD  ldemand_l = 12:ldemand_l
--- LOAD  intake = 13:intake
--- LOAD  nvalue = 14:nvalue
--- LOAD  sval = 15:sval
 285   
GDXIN   C:\Users\ikiyo\OneDrive\MAFF_2025\workspace simul\parameters.gdx
--- LOAD  n_group = 1:n_group
--- LOAD  stockpile = 2:stockpile
--- LOAD  wapply = 3:wapply
--- LOAD  uapply = 4:uapply
--- LOAD  lsu = 5:lsu
--- LOAD  dmcoef = 6:dmcoef
--- LOAD  pcoef = 7:pcoef
--- LOAD  acoef = 8:acoef
--- LOAD  fcoef = 9:fcoef
--- LOAD  ycoef = 10:ycoef
--- LOAD  yrrate = 11:yrrate
--- LOAD  irrate = 12:irrate
--- LOAD  frrate = 13:frrate
 289   
 290  * Organic fertilizer supply as residual of chemical fertilizer supply and total demand
 291      esupply("organic",e) = max(0, sum(c,data(c,"area")*edemand(c,e))-esupply("prod",e)-esupply("import",e) );
 292  * Convert hour/10a -> hour/1000ha
 293      ldemand_c(c) = ldemand_c(c)*(10**4);
 294  * Include deserted land into land endowment
 296      land_endw(r,"paddy_wet")  = land_endw(r,"paddy_wet")  + land_dsrt(r,"paddy_dsrt");
 297      land_endw(r,"field_rain") = land_endw(r,"field_rain") + land_dsrt(r,"field_dsrt");
 299  * dairycow half of newborn calves spent to produce beef
 300      acoef("beef","dairycow")      = acoef("beef","dairycow")*(0.5*head("calves")/head("dairycow"));
 301  * dairycow of lactating to produce milk
 302      acoef("milk","dairycow")      = acoef("milk","dairycow")*(sval("lactating")/head("dairycow"));
 303  * layinghens culled to produce chicken
 304      acoef("chicken","layinghens") = acoef("chicken","layinghens")*(sval("culled")/head("layinghens"));
 305   
 306      CRT(c,r,t)$(not sameas(r,'Hokkaido')) = yes$mmap(c,t);
 307      CRT(c,"Hokkaido",t)                   = yes$mmap_hok(c,t);
 308   
 309      tpop = sum((a,s), intake(a,s,"pop"));
 310   
 311      pintake(a,s,"calorie")       = intake(a,s,"pop") * intake(a,s,"calorie");
 312      pintake(a,s,"protein")       = intake(a,s,"pop") * intake(a,s,"protein");
 313      pintake(a,s,"fat")           = intake(a,s,"pop") * intake(a,s,"fat");
 314      pintake(a,s,"carbonhydrate") = intake(a,s,"pop") * intake(a,s,"carbonhydrate");
 315   
 316      nreq(nn) = sum((a,s),pintake(a,s,nn))/tpop;
 317   
 318      nnvalue(g,"calorie")         = nvalue(g,"value","calorie")/100;
 319      nnvalue(g,"protein")         = nvalue(g,"value","protein")/100;
 320      nnvalue(g,"fat")             = nvalue(g,"value","fat")/100;
 321      nnvalue(g,"carbonhydrate")   = nvalue(g,"value","carbonhydrate")/100;
 322      nnpcvalue(g,"calorie")       = nvalue(g,"pc","calorie");
 323      nnpcvalue(g,"protein")       = nvalue(g,"pc","protein");
 324      nnpcvalue(g,"fat")           = nvalue(g,"pc","fat");
 325      nnpcvalue(g,"carbonhydrate") = nvalue(g,"pc","carbonhydrate");
 326      nnpc(g)                      = nvalue(g,"pc","supplypd");
 327   
 328      t2g(g)       = data(g,"gross")/data(g,"total");
 329      t2p(g)       = data(g,"processing")/data(g,"total");
 330  * adjust processing rate (oil) of domestically produced soybeans
 331      t2p("soy")   = 18/data("soy","prod");
 332      t2p("psoy")  = 18/data("psoy","prod");
 333      t2f(g)       = data(g,"feed")/data(g,"total");
 334      g2n(g)       = data(g,"g2n")/100;
 335   
 336      x2n(c)         = data(c,"yield")*t2g(c)*g2n(c)*(10**9);
 337      x2nn(c,nn)     = x2n(c)*nnvalue(c,nn);
 338      x2f(c,i)       = data(i,"yield")*t2p(i)*pcoef(c,i)*(10**9);
 339      x2f("oil","rice") = data("rice","yield")*pcoef("oil","rice")*(10**9);
 340      x2fn(c,i,nn)   = x2f(c,i)*nnvalue(c,nn);
 341      x2a(ap,ls)     = acoef(ap,ls)*g2n(ap)*1000;
 342      x2an(ap,ls,nn) = x2a(ap,ls)*nnvalue(ap,nn)*0.8;
 343      x2fe(fe,c)     = fcoef(fe,c)*dmcoef(fe)*(10**3);
 344   
 345      cfcoef    = 1+rate_cfim/100;
 346      npecoef(c) = 1-yrrate(c)*rate_npe/100;
 347   
 348      im(g) $import(g)   = (1-irrate(g,'scn4'))*data(g,"import")*t2g(g)*g2n(g)*(10**9) $import(g);
 349      impc(g) $import(g) = im(g)/(tpop*(10**6)*365) $import(g);
 350      imnn(nn)           = sum(g, impc(g)*nnvalue(g,nn) $import(g));
 351   
 352  Display CRT, esupply, ldemand_c, land_endw, acoef , tpop;
 353   
 354   
