 475      dif                  'Objective function evaluated as difference value'
 476      rat                  'Objective function evaluated as rate of shortage';
 477   
 478      link(c)..             sum((r,l)$CRL(c,r,l), xrlcrop(c,r,l)) =e= xcrop(c);
 479      landbal(t,r,l)..      sum(c$CRL(c,r,l), xrlcrop(c,r,l) * CRT(c,r,t)) =l= land_endw(r,l);
 480   
 481      areamax_y(c)..        xcrop(c) $ paddy(c)   =l= limit*data(c,"area") $ paddy(c);
 482      areamax_u(c)..        xcrop(c) $ field(c)   =l= limit*data(c,"area") $ field(c);
 483      areamax_p(c)..        xcrop(c) $ pasture(c) =l= limit*data(c,"area") $ pasture(c);
 484      areamax_o(c)..        xcrop(c) $ orchard(c) =l=       data(c,"area") $ orchard(c);
 485      areamax_l(c)..        xcrop(c) $ local(c)   =l=       data(c,"area") $ local(c);
 486      areamax_wheat..       sum(c $total_wheat(c), xcrop(c)) =l= limit*data("wheat","area");
 487      areamax_barley..      sum(c $total_barley(c),xcrop(c)) =l= limit*data("barley","area");
 488      areamax_sweetp..      sum(c $total_sweetp(c),xcrop(c)) =l= limit*data("sweetp","area");
 489      areamax_potato..      sum(c $total_potato(c),xcrop(c)) =l= limit*data("potato","area");
 490      areamax_soy..         sum(c $total_soy(c),   xcrop(c)) =l= limit*data("soy","area");
 491   
 492      jan(c)..              xcrop(c) $ mmap(c,"jan") =l= data(c,"area") $ mmap(c,"jan");
 493      feb(c)..              xcrop(c) $ mmap(c,"feb") =l= data(c,"area") $ mmap(c,"feb");
 494      mar(c)..              xcrop(c) $ mmap(c,"mar") =l= data(c,"area") $ mmap(c,"mar");
 495      apr(c)..              xcrop(c) $ mmap(c,"apr") =l= data(c,"area") $ mmap(c,"apr");
 496      may(c)..              xcrop(c) $ mmap(c,"may") =l= data(c,"area") $ mmap(c,"may");
 497      jun(c)..              xcrop(c) $ mmap(c,"jun") =l= data(c,"area") $ mmap(c,"jun");
 498      jul(c)..              xcrop(c) $ mmap(c,"jul") =l= data(c,"area") $ mmap(c,"jul");
 499      aug(c)..              xcrop(c) $ mmap(c,"aug") =l= data(c,"area") $ mmap(c,"aug");
 500      sep(c)..              xcrop(c) $ mmap(c,"sep") =l= data(c,"area") $ mmap(c,"sep");
 501      oct(c)..              xcrop(c) $ mmap(c,"oct") =l= data(c,"area") $ mmap(c,"oct");
 502      nov(c)..              xcrop(c) $ mmap(c,"nov") =l= data(c,"area") $ mmap(c,"nov");
 503      dec(c)..              xcrop(c) $ mmap(c,"dec") =l= data(c,"area") $ mmap(c,"dec");
 504   
 505      eledemand(e)..        eled(e)  =e= sum(c, xcrop(c)*edemand(c,e));
 506      elesupply(e)..        eles(e)  =e= cfcoef*esupply("prod",e) + cfcoef*esupply("import",e) + esupply("organic",e);
 507  *   Chemical fertilizer coefficient (cfcoef) involves import and production except nitrogen
 508      elebal(e)..           eled(e)  =l= eles(e);
 509   
 510  *   Liebig's Law of the Minimum yield(c) = min_e [ a(c,e) + b(c,e)*fert(c,e) ] is executed as
 511  *                               yield(c) =l= a(c,e) + b(c,e)*fert(c,e)  (∀e)
 512  *   Maximize production in the objective function being executed also maximize yield(c) as much as possible.
 513  *   Since the above inequality must hold for all e, yield(c) corresponds to the “minimum value” of the potential yield for the scarsiest element.
 514      Liebig(c,e)..         zyield(c) =l= fertcoef(c,e,"intercept") + fertcoef(c,e,"slope")*fert(c,e);
 515      Liebigbal(e)..        sum(c, xcrop(c)*fert(c,e)) =l= eles(e);
 516   
 517      labdemand_c..         labd_c   =e= sum(c, xcrop(c)*ldemand_c(c)) /(10**9);
 518      labdemand_l..         labd_ls  =e= sum(ls,xlive(ls)*ldemand_l(ls))/(10**9);
 519      labbal..              labd_c + labd_ls  =l= sval("lsupply");
 520   
 521      tdndemand(ls)..       tdnd(ls) =e= xlive(ls)*fdemand(ls,"tdn")/1000;
 522      tdnsupply(ls)..       tdns(ls) =e= sum(fe, yfeed(ls,fe)*fsupply(ls,"tdn",fe)/100);
 523      tdnbal(ls)..          tdnd(ls) =l= tdns(ls);
 524   
 525      cpdemand(ls)..        cpd(ls)  =e= tdnd(ls)*fdemand(ls,"cp_mid")/100;
 526      cpdemand_low(ls)..    cpd(ls)  =e= tdnd(ls)*fdemand(ls,"cp_low")/100;
 527      cpdemand_high(ls)..   cpd(ls)  =e= tdnd(ls)*fdemand(ls,"cp_high")/100;
 528      cpsupply(ls)..        cps(ls)  =e= sum(fe, yfeed(ls,fe)*fsupply(ls,"cp",fe)/100);
 529      cpbal(ls)..           cpd(ls)  =l= cps(ls);
 530   
 531      dmsupply(fe)..        dms(fe)  =e= fconst(fe,"const")+(1-frrate(fe,'scn4'))*fconst(fe,"import")+sum(c, xcrop(c)*x2fe(fe,c));
 532      distbal(fe)..         dms(fe)  =g= sum(ls, yfeed(ls,fe));
 533      distbal_stock(fe)..   dms(fe)  =g= sum(ls, yfeed(ls,fe))-fconst(fe,"stock");
 534   
 535      bredbal(ls)..         xlive(ls) =l= limit*head(ls);
 536      dairyoxrep..          xlive("dairyox") =e= head("dairyox")*xlive("dairycow")/head("dairycow");
 537      heiferrep..           xlive("heifer")  =e= head("heifer") *xlive("dairycow")/head("dairycow");
 538      calfrep..             xlive("calves")  =e= head("calves") *xlive("dairycow")/head("dairycow");
 539   
 540   
 541      nutpet_c(c,nn)..      nnpotential_c(c,nn) =e= sum((r,l)$CRL(c,r,l), xrlcrop(c,r,l)*x2nn(c,nn)*ycoef(c,l)
 543                                                   )/(tpop*(10**6)*365);
 544   
 545      nutpet_f(c,nn)..      nnpotential_f(c,nn) =e= sum((i,r,l)$CRL(i,r,l), xrlcrop(i,r,l)*x2fn(c,i,nn)*ycoef(i,l)
 547                                                   )/(tpop*(10**6)*365);
 548   
 549      nutpet_l(ap,nn)..     nnpotential_l(ap,nn) =e= sum(ls, xlive(ls)*x2an(ap,ls,nn))/(tpop*(10**6)*365);
 550   
 551      caloriebal..          cdeficit =e= nreq("calorie")-imnn("calorie")
 552                                         -sum((c,ap), nnpotential_c(c,"calorie")+nnpotential_f(c,"calorie")+nnpotential_l(ap,"calorie"))
 554  *   Add a “very small linear term” to the objective function to avoid the saddle point solutions (all zero).
 555                            ;
 556   
 557      caloriebal_r..        cshortrate =e= cdeficit/nreq("calorie")
 559  *   Add a “very small linear term” to the objective function to avoid the saddle point solutions (all zero).
 560                            ;
 561   
 562   
 563      dietpet_c(c)..        dpotential_c(c) =e= sum((r,l)$CRL(c,r,l), xrlcrop(c,r,l)*x2n(c)*ycoef(c,l)
 565                                                    )/(tpop*(10**6)*365);
 566   
 567      dietpet_f(c)..        dpotential_f(c) =e= sum((i,r,l)$CRL(i,r,l), xrlcrop(i,r,l)*x2f(c,i)*ycoef(i,l)
 569                                                    )/(tpop*(10**6)*365);
 570   
 571      dietpet_l(ap)..       dpotential_l(ap) =e= sum(ls, xlive(ls)*x2a(ap,ls))/(tpop*(10**6)*365);
 572   
 573      dietbal(cg)..         delta(cg) =e= sum(c $cmap(cg,c), nnpc(c)-impc(c)-dpotential_c(c)-dpotential_f(c))
 575  *   Add a “very small linear term” to the objective function to avoid the saddle point solutions (all zero).
 576                            ;
 577   
 578      dietbal_r..           deltasumsq =e= sum(cg, sqr(
 579                                                       (delta(cg)/sum(c $cmap(cg,c), nnpc(c))) / n_group(cg)
 580                                                      )
 581                                              );
 582   
 583      adietbal(ag)..        adelta(ag) =e= sum(ap $amap(ag,ap), nnpc(ap)-impc(ap)-dpotential_l(ap)
 584                                              );
 585   
 586      adietbal_r..          adeltasumsq =e= sum(ag, sqr(
 587                                                       (adelta(ag)/sum(ap $amap(ag,ap), nnpc(ap))) / n_group(ag)
 588                                                       )
 589                                               );
 590   
 591      dif..                 target =e= weight*cdeficit + (1-weight)*(sum(cg,delta(cg))+sum(ag,adelta(ag)));
 592      rat..                 target =e= weight*cshortrate + (1-weight)*(deltasumsq +adeltasumsq);
 593   
 594   
 595   
