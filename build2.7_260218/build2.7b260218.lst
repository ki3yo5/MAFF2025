1368   
1369      xcbal("mean")             = (-1)*sum(t,mdietrep(t,"calorie","shortage"))/12;
1370      xcbal("max")              = (-1)*smax(t,mdietrep(t,"calorie","shortage"));
1371      xcbal("min")              = (-1)*smin(t,mdietrep(t,"calorie","shortage"));
1372   
1373      period("100%",rep)        = 365*stock("calorie","total")/xcbal(rep);
1374      period("90%",rep)         = 365*stock("calorie","total")/(xcbal(rep)-2158*0.1);
1375      period("80%",rep)         = 365*stock("calorie","total")/(xcbal(rep)-2158*0.2);
