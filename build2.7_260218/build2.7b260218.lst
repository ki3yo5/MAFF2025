 847      wfoodrep(w,c,"current_diet")   = nnpc(c) $processed(c);
 848      wfoodrep(w,c,"potential_diet") = wxdpotential_f(w,c)*npecoef(c) $processed(c);
 849      wfoodrep(w,c,"import_diet")    = impc(c)$processed(c);
 850      wfoodrep(w,c,"change_diet")    = wfoodrep(w,c,"potential_diet")+wfoodrep(w,c,"import_diet")-wfoodrep(w,c,"current_diet");
 851      wfoodrep(w,"total",frep)       = sum(c, wfoodrep(w,c,frep));
 852   
 853      wliverep(w,ap,"current_cal")   = nnpcvalue(ap,"calorie");
 854      wliverep(w,ap,"potential_cal" )= wxnnpotential_l(w,ap,"calorie");
 855      wliverep(w,ap,"current_diet")  = nnpc(ap);
 856      wliverep(w,ap,"potential_diet")= wxdpotential_l(w,ap);
 857      wliverep(w,ap,"import_diet")   = impc(ap);
 858      wliverep(w,ap,"change_diet")   = wliverep(w,ap,"potential_diet")+wliverep(w,ap,"import_diet")-wliverep(w,ap,"current_diet");
 859      wliverep(w,"total",frep)       = sum(ap, wliverep(w,ap,frep));
 860   
 861      wdietrep(w,nn,"required")      = nreq(nn);
 862      wdietrep(w,nn,"current")       = sum(g, nnpcvalue(g,nn));
 863      wdietrep(w,nn,"potential")     = sum(c, wxnnpotential_c(w,c,nn)+wxnnpotential_f(w,c,nn))
 864                                             + sum(ap, wxnnpotential_l(w,ap,nn))
 865                                             + sum(c,  data(c,"net")*nnvalue(c,nn)*(10**9) $marine(c))/(tpop*(10**6)*365)
 866                                             - sum(c,  wxnnpotential_c(w,c,nn)*(1-npecoef(c)) $edible(c))
 867                                             - sum(c,  wxnnpotential_f(w,c,nn)*(1-npecoef(c)) $processed(c));
