1220  *Post-calculation of vegetable cropping area
1221  parameters
1222      resLand(pattern,r,l,t)      'Residual land by month (1000ha)'
1223      resLabor(pattern)           'Residual labor (bil. hour)'
1224      resFert(pattern,e)          'Residual fertilizer (MT)'
1225      xveg_resLand(pattern)       'Maximum cropping area with residual land  (1000ha)'
1226      xveg_resLabor(pattern)      'Maximum cropping area with residual labor (1000ha)'
1227      xveg_resFert(pattern)       'Maximum cropping area with the scarsiest element (1000ha)'
1228      xveg(pattern)               'Post-calculation cropping area (1000ha)'
1229      dietxveg(pattern)           'Netfood supply (grams/day-capita)'
1230      nutxveg(pattern,nn)         'Nutrition supply (grams or kcal/day-capita)';
1231   
1232  scalar
1233      laborVeg                    'Labor demand of vegetable per month (bil. hour /1000ha)';
1234      laborVeg = ldemand_c("veges")/(10**9);
1235   
1236  * Residual land per month (croppable in "paddy_dry" or "field_irr" or "field_rain" and other region than "Hokkaido")
1237      resLand(pattern,r,l,t)
1238      $((sameas(l,'paddy_dry') or sameas(l,'field_irr') or sameas(l,'field_rain')) and (sameas(r,'Kanto_West') or sameas(r,'Okinawa'))) =
1239                               land_endw(r,l) - sum(c, pxrlcrop(pattern,c,r,l)*CRT(c,r,t));
1240  * Residual labor (annual)
1241      resLabor(pattern)      = sval("lsupply") - sum(c, pxcrop(pattern,c) * ldemand_c(c))/(10**9)
1242                                               - sum(ls, pxlive(pattern,ls)* ldemand_l(ls))/(10**9);
1243  * Residual fertilizer
1244      resFert(pattern,e)     = cfcoef*esupply("prod",e) + cfcoef*esupply("import",e) + esupply("organic",e)
1245                                               - sum(c, pxcrop(pattern,c) * edemand(c,e)
1247                                                    );
1248  * Non-negativity check
1249      resLand(pattern,r,l,t) = max(0, resLand(pattern,r,l,t));
1250      resLabor(pattern)      = max(0, resLabor(pattern));
1251      resFert(pattern,e)     = max(0, resFert(pattern,e));
1252  * Maximum cropping area with either residual input
1253      xveg_resLand(pattern)  = smax(t, sum((r,l),resLand(pattern,r,l,t)));
1254      xveg_resLabor(pattern) = resLabor(pattern)/laborVeg;
1255      xveg_resFert(pattern)  = smin(e, resFert(pattern,e)/edemand("veges",e)
1257                                    );
1258  * Joint constraint on cropping area of "veges"
1259      xveg(pattern)        = min( xveg_resLand(pattern),
1262                                  xveg_resLabor(pattern) );
1263  * Assign maximum area over t
1264      dietxveg(pattern)    = xveg(pattern)*x2n("veges")    /(tpop*(10**6)*365);
1265      nutxveg(pattern,nn)  = xveg(pattern)*x2nn("veges",nn)/(tpop*(10**6)*365);
1266   
1267  display resLand, resLabor, resFert, xveg_resLand, xveg_resLabor, xveg_resFert, xveg;
1268   
1269  *Assign "veges" values by post-calculation
1270      pxcrop(pattern,"veges")              = pxcrop(pattern,"veges")+xveg(pattern);
1271      pxdpotential_c(pattern,"veges")      = pxdpotential_c(pattern,"veges")+dietxveg(pattern);
1272      pxnnpotential_c(pattern,"veges",nn)  = pxnnpotential_c(pattern,"veges",nn)+nutxveg(pattern,nn);
1273  *Assign "fish" "seaweed" values as constant (Fish production to TAC limit 4650(1000MT) )
1274      pxdpotential_c(pattern,"fish")       = nnpc("fish")*4650*g2n("fish")/data("fish","net");
1275      pxnnpotential_c(pattern,"fish",nn)   = nnpcvalue("fish",nn)*4650*g2n("fish")/data("fish","net");
1276      pxdpotential_c(pattern,"seaweed")    = nnpc("seaweed");
1277      pxnnpotential_c(pattern,"seaweed",nn)= nnpcvalue("seaweed",nn);
1278   
1279      pcroprep(pattern,c,"current_cal")    = nnpcvalue(c,"calorie")$edible(c);
1280      pcroprep(pattern,c,"potential_cal")  = pxnnpotential_c(pattern,c,"calorie")*npecoef(c) $edible(c);
1281      pcroprep(pattern,c,"current_diet")   = nnpc(c)$edible(c);
1282      pcroprep(pattern,c,"potential_diet") = pxdpotential_c(pattern,c)*npecoef(c) $edible(c);
1283      pcroprep(pattern,c,"import_diet")    = impc(c)$edible(c);
1284      pcroprep(pattern,c,"change_diet")    = pcroprep(pattern,c,"potential_diet")+pcroprep(pattern,c,"import_diet")-pcroprep(pattern,c,"current_diet");
1285      pcroprep(pattern,"total",frep)       = sum(c, pcroprep(pattern,c,frep));
1286   
1287      pfoodrep(pattern,c,"current_cal")    = nnpcvalue(c,"calorie") $processed(c);
1288      pfoodrep(pattern,c,"potential_cal")  = pxnnpotential_f(pattern,c,"calorie")*npecoef(c) $processed(c);
1289      pfoodrep(pattern,c,"current_diet")   = nnpc(c) $processed(c);
1290      pfoodrep(pattern,c,"potential_diet") = pxdpotential_f(pattern,c)*npecoef(c) $processed(c);
1291      pfoodrep(pattern,c,"import_diet")    = impc(c)$processed(c);
1292      pfoodrep(pattern,c,"change_diet")    = pfoodrep(pattern,c,"potential_diet")+pfoodrep(pattern,c,"import_diet")-pfoodrep(pattern,c,"current_diet");
1293      pfoodrep(pattern,"total",frep)       = sum(c, pfoodrep(pattern,c,frep));
1294   
1295      pliverep(pattern,ap,"current_cal")   = nnpcvalue(ap,"calorie");
1296      pliverep(pattern,ap,"potential_cal") = pxnnpotential_l(pattern,ap,"calorie");
1297      pliverep(pattern,ap,"current_diet")  = nnpc(ap);
1298      pliverep(pattern,ap,"potential_diet")= pxdpotential_l(pattern,ap);
1299      pliverep(pattern,ap,"import_diet")   = impc(ap);
1300      pliverep(pattern,ap,"change_diet")   = pliverep(pattern,ap,"potential_diet")+pliverep(pattern,ap,"import_diet")-pliverep(pattern,ap,"current_diet");
1301      pliverep(pattern,"total",frep)       = sum(ap, pliverep(pattern,ap,frep));
1302   
1303      pmarinerep(pattern,c,"current_cal")    = nnpcvalue(c,"calorie") $marine(c);
1304      pmarinerep(pattern,c,"potential_cal")  = pxnnpotential_c(pattern,c,"calorie") $marine(c);
1305      pmarinerep(pattern,c,"current_diet")   = nnpc(c) $marine(c);
1306      pmarinerep(pattern,c,"potential_diet") = pxdpotential_c(pattern,c) $marine(c);
1307      pmarinerep(pattern,c,"import_diet")    = impc(c) $marine(c);
1308      pmarinerep(pattern,c,"change_diet")    = pmarinerep(pattern,c,"potential_diet")+pmarinerep(pattern,c,"import_diet")-pmarinerep(pattern,c,"current_diet");
1309      pmarinerep(pattern,"total",frep)       = sum(c, pmarinerep(pattern,c,frep));
1310   
1311      pdietrep(pattern,nn,"required")      = nreq(nn);
1312      pdietrep(pattern,nn,"current")       = sum(g, nnpcvalue(g,nn));
1313      pdietrep(pattern,nn,"potential")     =
1314                                             + sum(ap, pxnnpotential_l(pattern,ap,nn))
1315                                             + sum(c,  pxnnpotential_c(pattern,c,nn) $marine(c))
1316                                             + sum(c,  pxnnpotential_c(pattern,c,nn)*npecoef(c) $edible(c))
1317                                             + sum(c,  pxnnpotential_f(pattern,c,nn)*npecoef(c) $processed(c));
1318      pdietrep(pattern,nn,"import")        = imnn(nn);
1319      pdietrep(pattern,nn,"shortage")      = pdietrep(pattern,nn,"potential")+pdietrep(pattern,nn,"import")-pdietrep(pattern,nn,"required");
1320      pdietrep(pattern,nn,"srate")         = 100*(pdietrep(pattern,nn,"potential")+pdietrep(pattern,nn,"import"))/pdietrep(pattern,nn,"required");
1321   
1322      pradar(pattern,cg,"current")         = sum(c $cmap(cg,c), nnpc(c));
1323      pradar(pattern,cg,"potential")       = sum(c $cmap(cg,c), pcroprep(pattern,c,"potential_diet")+pfoodrep(pattern,c,"potential_diet"));
1324      pradar(pattern,cg,"import")          = sum(c $cmap(cg,c), impc(c));
1325      pradar(pattern,cg,"change")          = pradar(pattern,cg,"potential") + pradar(pattern,cg,"import") - pradar(pattern,cg,"current");
1326      pradar(pattern,cg,"srate")           = 100*(pradar(pattern,cg,"potential")+pradar(pattern,cg,"import"))/pradar(pattern,cg,"current");
1327      paradar(pattern,ag,"current")        = sum(ap $amap(ag,ap), nnpc(ap));
1328      paradar(pattern,ag,"potential")      = sum(ap $amap(ag,ap), pliverep(pattern,ap,"potential_diet"));
1329      paradar(pattern,ag,"import")         = sum(ap $amap(ag,ap), impc(ap));
1330      paradar(pattern,ag,"change")         = paradar(pattern,ag,"potential") + paradar(pattern,ag,"import") - paradar(pattern,ag,"current");
1331      paradar(pattern,ag,"srate")          = 100*(paradar(pattern,ag,"potential")+paradar(pattern,ag,"import")) / paradar(pattern,ag,"current");
1332   
1333      plandrep_region("current","total",c) = data(c,"area");
1334      plandrep_region(pattern,r,c)         = sum(l, pxrlcrop(pattern,c,r,l));
1335      plandrep_region(pattern,"total",c)   = sum(r, plandrep_region(pattern,r,c));
1336      plandrep_region(pattern,r,"total")   = sum(c, plandrep_region(pattern,r,c));
1337      plandrep_month(pattern,t,l,c)        = sum(r, pxrlcrop(pattern,c,r,l)*CRT(c,r,t));
1338      plandrep_month(pattern,t,l,"total")  = sum(c, plandrep_month(pattern,t,l,c));
1339  *Assign "veges" values by post-calculation
1340      plandrep_region(pattern,"total","veges") = pxcrop(pattern,"veges");
1341   
1342      plaborrep(pattern,c)                 = pxcrop(pattern,c) *ldemand_c(c) /(10**9);
1343      plaborrep("current",c)               = data(c,"area")    *ldemand_c(c) /(10**9);
1344      plaborrep(pattern,ls)                = pxlive(pattern,ls)*ldemand_l(ls)/(10**9);
1345      plaborrep("current",ls)              = head(ls)          *ldemand_l(ls)/(10**9);
1346      plaborrep(pattern,"total")           = sum(c,plaborrep(pattern,c)) + sum(ls,plaborrep(pattern,ls));
1347      plaborrep("current","total")         = sum(c,plaborrep("current",c)) + sum(ls,plaborrep("current",ls));
1348   
1349      pfertrep("current",e,c)              = data(c,"area")*edemand(c,e);
1350      pfertrep("current",e,"total")        = sum(c,pfertrep("current",e,c));
1351      pfertrep(pattern,e,c)                = pxcrop(pattern,c)*edemand(c,e)
1353      ;
1354      pfertrep(pattern,e,"total")          = sum(c,pfertrep(pattern,e,c));
1355   
1357   
1358   
1359   
