1361      stock("grossfood",c)      = stockpile(c);
1362      stock("netfood",c)        = stockpile(c)*g2n(c);
1363      stock("netfood","total")  = sum(c,stock("netfood",c));
1364      stock("netfoodpc",c)      = stock("netfood",c)*(10**9)/(tpop*(10**6)*365);
1365      stock("netfoodpc","total")= sum(c,stock("netfoodpc",c));
